{
  "manifest_version": 3,
  "name": "ফোকাস মাস্টার — এক সময়ে একটাই কাজ",
  "version": "3.0.0",
  "description": "Habit Tracker, Pomodoro, Focus Guard, সাইট ব্লকার, Notes — মনোযোগ বাড়ানোর সবকিছু।",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ফোকাস মাস্টার",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": [
    "storage", "notifications", "alarms", "tabs", "scripting", "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_start",
    "all_frames": false
  }]
}

