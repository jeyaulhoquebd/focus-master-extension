{
  "manifest_version": 3,
  "name": "ফোকাস মাস্টার — এক সময়ে একটাই কাজ",
  "version": "1.0.0",
  "description": "Pomodoro টাইমার, সাইট ব্লকার, লক্ষ্য, Distraction List — মনোযোগ ধরে রাখার ৮টি অভ্যাস।",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ফোকাস মাস্টার"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}